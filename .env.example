# Copy to .env.local and fill in from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only. Sanity API token with "Editor" permissions (sanity.io/manage → API → Tokens).
# Used to save contact form submissions. Never prefix with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=

# Server-only. Shared secret for the Sanity → /api/revalidate webhook.
# Generate a long random string and set the same value in the Sanity webhook.
SANITY_REVALIDATE_SECRET=
